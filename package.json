{
  "name": "dili-workbench",
  "version": "0.4.2",
  "private": false,
  "type": "module",
  "description": "Dili (嘀哩工作台): a local-first web home for Claude Code, Codex and DeepSeek Harness sessions",
  "scripts": {
    "postinstall": "node scripts/prepare-pty.mjs",
    "preflight": "node scripts/prepare-pty.mjs && tsx scripts/check-pty.ts",
    "prestart": "npm run preflight",
    "predev": "npm run preflight",
    "dev": "tsx watch server/index.ts --dev",
    "start": "tsx server/index.ts",
    "build": "tsc --noEmit && tsx scripts/build-client.ts",
    "test": "tsx --test --test-concurrency=6 server/*.test.ts scripts/fixtures/*.test.ts",
    "check": "tsc --noEmit",
    "build:relay": "tsx scripts/build-relay.ts",
    "prepare:relay-clients": "tsx scripts/prepare-relay-clients.ts",
    "package:release": "tsx scripts/package-release.ts",
    "relay": "tsx server/relay-main.ts",
    "test:web": "playwright test",
    "verify": "npm run check && npm test && npm run test:web",
    "doctor": "tsx scripts/doctor.ts",
    "test:soak": "tsx scripts/soak.ts",
    "test:smoke:dsh": "tsx scripts/dsh-workflow-smoke.ts",
    "test:smoke:codex": "tsx scripts/codex-workflow-smoke.ts",
    "test:smoke:codex-chat": "tsx scripts/codex-chat-smoke.ts",
    "test:smoke:codex-image": "tsx scripts/codex-image-smoke.ts",
    "test:terminal-load": "tsx scripts/terminal-load.ts",
    "test:smoke:claude-image": "tsx scripts/claude-workflow-smoke.ts --image-only --loopback-fixture",
    "test:smoke:claude": "tsx scripts/claude-workflow-smoke.ts",
    "test:smoke:claude-chat": "tsx scripts/claude-chat-smoke.ts",
    "test:smoke:workspace": "tsx scripts/workspace-workflow-smoke.ts",
    "backup": "tsx scripts/backup.ts",
    "prepack": "npm run build",
    "test:package": "npm run build && node scripts/package-smoke.mjs"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-serialize": "^0.14.0",
    "@xterm/headless": "^6.0.0",
    "@xterm/xterm": "^6.0.0",
    "express": "^5.1.0",
    "highlight.js": "^11.12.0",
    "lucide-react": "^0.468.0",
    "node-pty": "^1.1.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-markdown": "^10.1.0",
    "rehype-highlight": "^7.0.2",
    "remark-gfm": "^4.0.1",
    "smol-toml": "^1.9.1",
    "tsx": "^4.20.0",
    "vditor": "4.0.0",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^5.1.0",
    "typescript": "^5.9.0",
    "vite": "^7.2.0"
  },
  "bin": {
    "dili": "bin/dili.mjs"
  },
  "files": [
    "bin/",
    "server/",
    "shared/",
    "scripts/check-start.mjs",
    "scripts/check-pty.ts",
    "scripts/prepare-pty.mjs",
    "scripts/doctor.ts",
    "dist/client/",
    "README.MD",
    "docs/"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xiaoqiang-cheng/dili.git"
  },
  "homepage": "https://github.com/xiaoqiang-cheng/dili#readme",
  "license": "UNLICENSED"
}
